<div class="sv-banner" data-sv-banner data-interval="{{ section.settings.interval }}"
     role="region" aria-label="{{ 'general.announcement' | t: default: 'Announcement' }}">
  {%- if section.settings.enable_confetti -%}
    <div class="sv-confetti" data-sv-confetti aria-hidden="true"></div>
  {%- endif -%}
  <div class="sv-banner__track">
    {%- for block in section.blocks -%}
      <span class="sv-banner__msg" data-sv-msg data-confetti="{{ block.settings.confetti }}"
            style="transform:translateY({{ forloop.index0 | times: 100 }}%);"
            {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" style="color:inherit;">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "range", "id": "interval", "label": "Rotation interval", "min": 3000, "max": 9500, "step": 500, "default": 5500, "unit": "ms" },
    { "type": "checkbox", "id": "enable_confetti", "label": "Allow confetti on messages", "default": true }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "text", "label": "Message", "default": "Enjoy the first time user 10% discount on your first purchase." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "confetti", "label": "Show confetti on this message", "default": false }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Enjoy the first time user 10% discount on your first purchase." } },
      { "type": "message", "settings": { "text": "Onam special 10% off on Onam collection", "confetti": true } },
      { "type": "message", "settings": { "text": "Buy worth Rs 3000 and get a Rs 500 worth discount on checkout" } }
    ]
  }
}
{% endschema %}
