{%- comment -%}
  design.md 4.G + known gap 4: Shopify has no native wishlist object. This
  renders real saved items IF customer.metafields.custom.wishlist (a product
  list reference, Settings → Custom data → Customers) is populated — by a
  wishlist app's own snippet, or a custom build. Until that exists, every
  customer sees the empty state, which is the honest, always-correct default.
{%- endcomment -%}
<section class="sv-wish">
  <nav class="sv-pdp__crumbs" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a> / {{ section.settings.heading | default: 'Wishlist' }}
  </nav>
  {%- if section.settings.kicker != blank -%}
    <div class="sv-link-upper">{{ section.settings.kicker }}</div>
  {%- endif -%}
  <h1 class="sv-wish__title">{{ section.settings.heading }}</h1>

  {%- assign saved = customer.metafields.custom.wishlist.value -%}
  {%- if saved.size > 0 -%}
    <div class="sv-wish__grid">
      {%- for product in saved -%}
        <div class="sv-wish__item">
          <button type="button" class="sv-wish__remove" data-sv-wishlist-remove data-product-id="{{ product.id }}" aria-label="Remove {{ product.title | escape }}">&times;</button>
          {%- render 'product-card', product: product, show_rating: false, show_price: true, card_class: 'sv-card--grid' -%}
          <div class="sv-wish__actions">
            {%- form 'product', product -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="sv-wish__add" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
                {% if product.selected_or_first_available_variant.available %}Add To Bag{% else %}Sold Out{% endif %}
              </button>
            {%- endform -%}
            <a class="sv-wish__view" href="{{ product.url }}">View</a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="sv-wish__empty">
      <p>{{ section.settings.empty_text }}</p>
      <a class="sv-btn-outline" href="{{ section.settings.empty_cta_url | default: routes.all_products_collection_url }}">{{ section.settings.empty_cta_label }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Saved Items" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "My Wishlist" },
    { "type": "text", "id": "empty_text", "label": "Empty-state copy", "default": "You haven't saved anything yet." },
    { "type": "text", "id": "empty_cta_label", "label": "Empty-state button label", "default": "Shop The Collection" },
    { "type": "url", "id": "empty_cta_url", "label": "Empty-state button link" }
  ],
  "presets": [{ "name": "Wishlist" }]
}
{% endschema %}
