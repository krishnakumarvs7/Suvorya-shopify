{%- comment -%}
  design.md 4.I: hairline-topped block, left-aligned, max-width 620px.
  Deliberately the thinnest archetype — no imagery.
{%- endcomment -%}
<section class="sv-soon">
  <nav class="sv-pdp__crumbs" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a> / {{ section.settings.heading | default: page.title }}
  </nav>
  <div class="sv-soon__block">
    {%- if section.settings.kicker != blank -%}
      <div class="sv-link-upper">{{ section.settings.kicker }}</div>
    {%- endif -%}
    <h1 class="sv-soon__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.body != blank -%}
      <p class="sv-soon__body">{{ section.settings.body }}</p>
    {%- endif -%}
    <div class="sv-soon__ctas">
      {%- if section.settings.primary_label != blank -%}
        <a class="sv-pdp__atc" style="width:auto;padding:14px 32px;" href="{{ section.settings.primary_url | default: routes.all_products_collection_url }}">
          <span>{{ section.settings.primary_label }}</span>
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a class="sv-btn-outline" href="{{ section.settings.secondary_url | default: '#' }}">{{ section.settings.secondary_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coming soon",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Coming Soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This Edit" },
    {
      "type": "textarea", "id": "body", "label": "Body",
      "default": "This edit is still being made. Pieces are photographed, priced and released a collection at a time, so the page will open when the full set is ready."
    },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop All" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Notify Me" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Coming soon" }]
}
{% endschema %}
