<section class="sv-marquee" aria-label="{{ section.settings.aria | escape }}">
  <div class="sv-marquee__rail" style="animation-duration:{{ section.settings.speed }}s;">
    {%- for pass in (1..2) -%}
      <div class="sv-marquee__group" {% if pass == 2 %}aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <span class="sv-marquee__word">{{ block.settings.text }}</span>
          <span class="sv-marquee__dot" aria-hidden="true">&#10022;</span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    { "type": "range", "id": "speed", "label": "Loop duration", "min": 18, "max": 70, "step": 2, "default": 34, "unit": "s" },
    { "type": "text", "id": "aria", "label": "Accessible label", "default": "Brand values" }
  ],
  "blocks": [
    { "type": "phrase", "name": "Phrase", "limit": 6, "settings": [
      { "type": "text", "id": "text", "label": "Phrase", "default": "Buy Less, Buy Better" }
    ]}
  ],
  "presets": [{
    "name": "Marquee",
    "blocks": [
      { "type": "phrase", "settings": { "text": "Buy Less, Buy Better" } },
      { "type": "phrase", "settings": { "text": "Handcrafted In India" } },
      { "type": "phrase", "settings": { "text": "Modern Heirlooms" } }
    ]
  }]
}
{% endschema %}
