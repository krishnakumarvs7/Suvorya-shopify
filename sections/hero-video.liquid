<section class="sv-hero">
  <div class="sv-hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video
         | video_tag: image_size: '1920x', autoplay: true, loop: true, muted: true, controls: false }}
    {%- else -%}
      <video
        {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1920 }}"{% else %}poster="{{ 'hero-poster.jpg' | asset_url }}"{% endif %}
        preload="metadata" autoplay muted loop playsinline>
        <source src="{{ 'hero-video.mp4' | asset_url }}" type="video/mp4">
      </video>
    {%- endif -%}

    <div class="sv-hero__scrim"></div>

    <div class="sv-hero__body">
      {%- if section.settings.heading != blank -%}
        <h1 class="sv-hero__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="sv-btn-outline" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero video",
  "settings": [
    { "type": "video", "id": "video", "label": "Video", "info": "Leave empty to use assets/hero-video.mp4" },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heritage, Worn Lightly" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop The Collection" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero video" }]
}
{% endschema %}
