{%- comment -%}
  Reviews block. The summary reads the reviews.rating / reviews.rating_count
  metafields (Shopify Product Reviews, Judge.me, Loox all write these).
  Shopify exposes no star DISTRIBUTION and no review BODIES to Liquid, so the
  bars and the listed reviews are section content — replace this whole section
  with your review app's own block once one is installed.
{%- endcomment -%}

{%- assign rating = product.metafields.reviews.rating.value -%}
{%- assign rating_count = product.metafields.reviews.rating_count.value -%}
{%- assign shown = rating | default: section.settings.fallback_rating -%}

<section id="reviews" class="sv-reviews">
  <h2 class="sv-section-title">{{ section.settings.heading }}</h2>

  <div class="sv-reviews__summary">
    <div>
      <div class="sv-reviews__score">{{ shown | round: 1 }}</div>
      {%- assign full = shown | round -%}
      <div class="sv-reviews__stars" aria-hidden="true">{%- for i in (1..5) -%}{% if i <= full %}★{% else %}☆{% endif %}{%- endfor -%}</div>
      <div class="sv-reviews__based">Based on {{ rating_count | default: section.settings.fallback_count }} reviews</div>
      {%- if section.settings.write_url != blank -%}
        <a class="sv-btn-outline" href="{{ section.settings.write_url }}">{{ section.settings.write_label }}</a>
      {%- endif -%}
    </div>

    <div class="sv-reviews__bars">
      {%- assign pcts = section.settings.distribution | split: ',' -%}
      {%- for i in (1..5) -%}
        {%- assign star = 6 | minus: i -%}
        {%- assign pct = pcts[i | minus: 1] | strip | plus: 0 -%}
        <div class="sv-reviews__bar">
          <span class="sv-reviews__bar-label">{{ star }} star</span>
          <span class="sv-reviews__bar-track"><span style="width:{{ pct }}%;"></span></span>
          <span class="sv-reviews__bar-pct">{{ pct }}%</span>
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- for block in section.blocks -%}
    <article class="sv-review" {{ block.shopify_attributes }}>
      <div>
        <div class="sv-review__who">{{ block.settings.name }}</div>
        <div class="sv-review__meta">{{ block.settings.meta }}</div>
      </div>
      <div>
        {%- assign r = block.settings.stars | plus: 0 -%}
        <span class="sv-review__stars" aria-hidden="true">{%- for i in (1..5) -%}{% if i <= r %}★{% else %}☆{% endif %}{%- endfor -%}</span>
        <div class="sv-review__title">{{ block.settings.title }}</div>
        <p class="sv-review__body">{{ block.settings.body }}</p>
      </div>
    </article>
  {%- endfor -%}

  {%- if section.settings.more_url != blank -%}
    <div class="sv-reviews__more"><a href="{{ section.settings.more_url }}">{{ section.settings.more_label }}</a></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews" },
    { "type": "paragraph", "content": "Score and count come from the reviews.rating metafield when present. Distribution and the reviews below are entered here — Shopify does not expose them to Liquid." },
    { "type": "text", "id": "distribution", "label": "Distribution (5,4,3,2,1 star %)", "default": "82,14,4,0,0" },
    { "type": "text", "id": "fallback_rating", "label": "Fallback score", "default": "4.8" },
    { "type": "text", "id": "fallback_count", "label": "Fallback review count", "default": "57" },
    { "type": "text", "id": "write_label", "label": "Write-review label", "default": "Write a Review" },
    { "type": "url", "id": "write_url", "label": "Write-review link" },
    { "type": "text", "id": "more_label", "label": "Load-more label", "default": "Load More Reviews" },
    { "type": "url", "id": "more_url", "label": "Load-more link" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Ananya R." },
        { "type": "text", "id": "meta", "label": "Meta line", "default": "March 2026 · Verified purchase" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Headline", "default": "Wore it through three functions" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [{ "name": "Product reviews" }]
}
{% endschema %}
