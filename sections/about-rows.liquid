{%- comment -%}
  Alternating image/text rows — design.md 4.D: 1fr 1fr, gap --space-8,
  align-items:center, image aspect-ratio 4/5, text = kicker + H2 + paragraph.
  Each block alternates side automatically; "Image side" setting overrides.
{%- endcomment -%}
<section class="sv-about-rows">
  {%- for block in section.blocks -%}
    {%- assign is_odd = forloop.index0 | modulo: 2 -%}
    {%- assign reverse = false -%}
    {%- if block.settings.side == 'right' -%}
      {%- assign reverse = true -%}
    {%- elsif block.settings.side == 'auto' and is_odd == 1 -%}
      {%- assign reverse = true -%}
    {%- endif -%}
    <div class="sv-about-row{% if reverse %} is-reversed{% endif %}" {{ block.shopify_attributes }}>
      <div class="sv-about-row__media">
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 900 }}"
               srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
               sizes="(max-width: 749px) 100vw, 50vw"
               alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
               loading="lazy" decoding="async">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div class="sv-about-row__text">
        {%- if block.settings.kicker != blank -%}
          <div class="sv-link-upper">{{ block.settings.kicker }}</div>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h2 class="sv-about-row__heading">{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if block.settings.body != blank -%}
          <div class="sv-about-row__body">{{ block.settings.body }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "About rows",
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Craftsmanship" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Hand-finished, piece by piece." },
        { "type": "richtext", "id": "body", "label": "Body" },
        {
          "type": "select", "id": "side", "label": "Image side", "default": "auto",
          "options": [
            { "value": "auto", "label": "Alternate automatically" },
            { "value": "left", "label": "Image left" },
            { "value": "right", "label": "Image right" }
          ]
        }
      ]
    }
  ],
  "presets": [{
    "name": "About rows",
    "blocks": [
      { "type": "row", "settings": { "kicker": "Craftsmanship", "heading": "Hand-finished, piece by piece." } },
      { "type": "row", "settings": { "kicker": "Philosophy", "heading": "Heritage, worn lightly." } }
    ]
  }]
}
{% endschema %}
