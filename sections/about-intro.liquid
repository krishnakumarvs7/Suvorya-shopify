{%- comment -%}
  Centred intro block — design.md 4.D: kicker + H1 + lead, max-width 760px.
{%- endcomment -%}
<section class="sv-about-intro">
  {%- if section.settings.kicker != blank -%}
    <div class="sv-link-upper" style="text-align:center;">{{ section.settings.kicker }}</div>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}
    <h1 class="sv-about-intro__title">{{ section.settings.heading }}</h1>
  {%- endif -%}
  {%- if section.settings.lead != blank -%}
    <p class="sv-about-intro__lead">{{ section.settings.lead }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "About intro",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Temple jewellery, for the everyday." },
    {
      "type": "textarea", "id": "lead", "label": "Lead paragraph",
      "default": "Suvorya began with a question: why should the artistry of temple jewellery live only inside a wedding box? We set out to bring its pearls, kemp stones, and gold filigree into daily life — wearable, accessible, and unmistakably rooted in tradition."
    }
  ],
  "presets": [{ "name": "About intro" }]
}
{% endschema %}
