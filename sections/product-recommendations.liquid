{%- comment -%}
  "You May Also Like" — 4-up grid using Shopify's product recommendations API,
  with the section's own collection setting as the fallback.
{%- endcomment -%}

<section class="sv-recs"
  data-sv-recs
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.count }}">
  <h2 class="sv-section-title">{{ section.settings.heading }}</h2>
  <div class="sv-recs__grid">
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      {%- for p in recommendations.products -%}
        {%- render 'product-card', product: p, show_rating: false, show_price: true -%}
      {%- endfor -%}
    {%- else -%}
      {%- assign fallback = collections[section.settings.collection] -%}
      {%- for p in fallback.products limit: section.settings.count -%}
        {%- unless p.id == product.id -%}
          {%- render 'product-card', product: p, show_rating: false, show_price: true -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "You may also like",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like" },
    { "type": "range", "id": "count", "label": "Products shown", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "collection", "id": "collection", "label": "Fallback collection", "info": "Used when Shopify has no recommendations yet." }
  ],
  "presets": [{ "name": "You may also like" }]
}
{% endschema %}
