{%- comment -%}
  Product card for the home-page rails and collection grid.
  Params:
    product      — product object (required)
    show_rating  — boolean; stars + count above the title
    show_price   — boolean
    card_class   — optional extra class on the wrapper (e.g. "sv-card--grid")
    swatch_option — optional option name (e.g. "Color"); renders small colour
                    swatches below the price, one per value, image-mapped the
                    same way the product page does (image order = value order)
  Ratings read the standard review-app metafields; products without them render no stars.
  Badges read a "badge:<label>" product tag, e.g. "badge:bestseller" → BESTSELLER.
{%- endcomment -%}

{%- assign rating = product.metafields.reviews.rating.value -%}
{%- assign rating_count = product.metafields.reviews.rating_count.value -%}

{%- assign badge_label = blank -%}
{%- for tag in product.tags -%}
  {%- if tag contains 'badge:' -%}
    {%- assign badge_label = tag | remove_first: 'badge:' | strip | upcase -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

<a class="sv-card{% if card_class %} {{ card_class }}{% endif %}" href="{{ product.url }}">
  <div class="sv-card__media" data-sv-slide>
    {%- if badge_label != blank -%}
      <span class="sv-card__badge">{{ badge_label }}</span>
    {%- endif -%}
    {%- if product.images.size > 0 -%}
      {%- for image in product.images limit: 3 -%}
        <img
          src="{{ image | image_url: width: 900 }}"
          srcset="{{ image | image_url: width: 450 }} 450w, {{ image | image_url: width: 900 }} 900w"
          sizes="(max-width: 749px) 72vw, 25vw"
          alt="{{ image.alt | default: product.title | escape }}"
          class="{% if forloop.first %}is-active{% endif %}"
          loading="lazy" decoding="async"
          width="{{ image.width }}" height="{{ image.height }}">
      {%- endfor -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'sv-card__placeholder' }}
    {%- endif -%}
  </div>

  {%- if show_rating and rating -%}
    {%- assign full = rating | round -%}
    <div class="sv-card__rating">
      <span class="sv-card__stars" aria-hidden="true">
        {%- for i in (1..5) -%}{% if i <= full %}★{% else %}☆{% endif %}{%- endfor -%}
      </span>
      <span class="sv-card__count">
        {{ rating | round: 1 }}{% if rating_count %} ({{ rating_count }}){% endif %}
      </span>
      <span class="visually-hidden">{{ rating | round: 1 }} out of 5 stars{% if rating_count %}, {{ rating_count }} reviews{% endif %}</span>
    </div>
  {%- endif -%}

  <div class="sv-card__title">{{ product.title }}</div>

  {%- if show_price -%}
    <div class="sv-card__price">
      {%- if product.compare_at_price > product.price -%}
        {{ product.price | money }} <s>{{ product.compare_at_price | money }}</s>
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if swatch_option != blank -%}
    {%- assign sv_swatch_opt = blank -%}
    {%- for option in product.options_with_values -%}
      {%- if option.name == swatch_option -%}{%- assign sv_swatch_opt = option -%}{%- endif -%}
    {%- endfor -%}
    {%- if sv_swatch_opt -%}
      <div class="sv-card__swatches">
        {%- for value in sv_swatch_opt.values limit: 5 -%}
          {%- assign vimg = product.images[forloop.index0] -%}
          <span class="sv-card__swatch" title="{{ value | escape }}">
            {%- if vimg -%}<img src="{{ vimg | image_url: width: 60 }}" alt="" loading="lazy">{%- endif -%}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</a>
