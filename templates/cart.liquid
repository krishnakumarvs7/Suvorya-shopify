{%- comment -%}
  Stub template. The home page is fully built; this page is scaffolding so the
  theme validates and uploads. Replace the body with real sections as each
  design component is converted.
{%- endcomment -%}
<section style="padding:calc(var(--header-h) + var(--banner-h) + var(--space-8)) var(--container-pad) var(--space-9);">
  <h1 class="sv-section-title">Bag</h1>
  {%- if cart.item_count == 0 -%}
    <p style="font-size:14px;color:var(--text-muted);">Your bag is empty.</p>
  {%- else -%}
    {%- form 'cart', cart -%}
      {%- for item in cart.items -%}
        <div style="display:flex;gap:var(--space-5);align-items:center;padding:var(--space-4) 0;border-bottom:1px solid var(--border-hairline);">
          <div style="flex:1;font-size:14px;">{{ item.product.title }}</div>
          <div style="font-size:13px;color:var(--text-muted);">{{ item.quantity }} &times; {{ item.final_price | money }}</div>
        </div>
      {%- endfor -%}
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:var(--space-6);">
        <div style="font-size:14px;">Subtotal {{ cart.total_price | money }}</div>
        <button class="sv-btn-outline" type="submit" name="checkout" style="background:none;cursor:pointer;">Checkout</button>
      </div>
    {%- endform -%}
  {%- endif -%}
</section>
