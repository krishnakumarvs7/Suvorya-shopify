{%- comment -%}
  Stub template. The home page is fully built; this page is scaffolding so the
  theme validates and uploads. Replace the body with real sections as each
  design component is converted.
{%- endcomment -%}
<section style="padding:calc(var(--header-h) + var(--banner-h) + var(--space-8)) var(--container-pad) var(--space-9);">
  <h1 class="sv-section-title">{{ page.title }}</h1>
  <div style="max-width:70ch;margin-top:var(--space-6);font-size:15px;line-height:var(--leading-body);">{{ page.content }}</div>
  {%- form 'contact' -%}
    <div style="display:grid;gap:var(--space-4);max-width:480px;margin-top:var(--space-6);">
      <input type="email" name="contact[email]" placeholder="Email" required style="padding:12px;border:1px solid var(--border-hairline);font:inherit;">
      <textarea name="contact[body]" rows="5" placeholder="Message" style="padding:12px;border:1px solid var(--border-hairline);font:inherit;"></textarea>
      <button class="sv-btn-outline" type="submit" style="background:none;cursor:pointer;">Send</button>
    </div>
  {%- endform -%}
</section>
