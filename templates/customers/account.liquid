{%- comment -%}
  Stub template. The home page is fully built; this page is scaffolding so the
  theme validates and uploads. Replace the body with real sections as each
  design component is converted.
{%- endcomment -%}
<section style="padding:calc(var(--header-h) + var(--banner-h) + var(--space-8)) var(--container-pad) var(--space-9);">
  <h1 class="sv-section-title">Account</h1>
  <div style="margin-top:var(--space-6);display:grid;gap:var(--space-5);">
    <a class="sv-link-upper" href="{{ routes.account_addresses_url }}">Addresses</a>
    {%- for order in customer.orders -%}
      <a href="{{ order.customer_url }}" style="font-size:14px;color:var(--ink);">{{ order.name }} &middot; {{ order.created_at | date: '%d %b %Y' }} &middot; {{ order.total_price | money }}</a>
    {%- endfor -%}
    <a class="sv-link-upper" href="{{ routes.account_logout_url }}">Sign out</a>
  </div>
</section>
