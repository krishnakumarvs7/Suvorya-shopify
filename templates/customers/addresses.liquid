<section style="padding:calc(var(--header-h) + var(--banner-h) + var(--space-8)) var(--container-pad) var(--space-9);">
  <h1 class="sv-section-title">Addresses</h1>
  <div style="margin-top:var(--space-6);display:grid;gap:var(--space-5);">
    {%- for address in customer.addresses -%}
      <div style="font-size:14px;line-height:var(--leading-body);">{{ address | format_address }}</div>
    {%- endfor -%}
  </div>
</section>
