{%- comment -%}
  Stub template. The home page is fully built; this page is scaffolding so the
  theme validates and uploads. Replace the body with real sections as each
  design component is converted.
{%- endcomment -%}
<section style="padding:calc(var(--header-h) + var(--banner-h) + var(--space-8)) var(--container-pad) var(--space-9);">
  <h1 class="sv-section-title">Order {{ order.name }}</h1>
  <div style="margin-top:var(--space-6);">
    {%- for line in order.line_items -%}
      <div style="display:flex;justify-content:space-between;padding:var(--space-3) 0;border-bottom:1px solid var(--border-hairline);font-size:14px;">
        <span>{{ line.title }}</span><span style="color:var(--text-muted);">{{ line.quantity }} &times; {{ line.final_price | money }}</span>
      </div>
    {%- endfor -%}
    <div style="margin-top:var(--space-5);font-size:14px;">Total {{ order.total_price | money }}</div>
  </div>
</section>
