{%- comment -%}
  Stub template. The home page is fully built; this page is scaffolding so the
  theme validates and uploads. Replace the body with real sections as each
  design component is converted.
{%- endcomment -%}
<section style="padding:calc(var(--header-h) + var(--banner-h) + var(--space-8)) var(--container-pad) var(--space-9);">
  <h1 class="sv-section-title">Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" style="margin-top:var(--space-6);">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search" style="padding:12px;border:1px solid var(--border-hairline);font:inherit;min-width:min(100%,320px);">
  </form>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,240px),1fr));gap:20px;margin-top:var(--space-6);">
    {%- for item in search.results -%}
      {%- if item.object_type == 'product' -%}
        {%- render 'product-card', product: item, show_rating: false, show_price: true -%}
      {%- else -%}
        <a href="{{ item.url }}" style="font-size:14px;color:var(--ink);">{{ item.title }}</a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
